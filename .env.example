# Where to forward. Any OpenAI-compatible /chat/completions endpoint.
DEJACACHE_UPSTREAM_URL=https://api.openai.com/v1

# Cosine similarity an L1 candidate must clear to be served.
# Raise it to serve fewer, safer hits; lower it to save more and risk a wrong
# answer. Measured on BAAI/bge-small-en-v1.5, close paraphrases land ~0.80-0.85.
DEJACACHE_SIMILARITY_THRESHOLD=0.80

# Cache read budget. Slower than this and we pass through instead of waiting.
DEJACACHE_LOOKUP_TIMEOUT_MS=50

# How long the customer's own upstream call may take.
DEJACACHE_UPSTREAM_TIMEOUT_S=120

# DEBUG logs prompt text. Leave at INFO unless you are debugging a match.
DEJACACHE_LOG_LEVEL=INFO
